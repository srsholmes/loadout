{
  "name": "@loadout/plugin-apex",
  "version": "0.0.1",
  "type": "module",
  "dependencies": {
    "react": "^18.3.0",
    "react-icons": "^5.6.0",
    "@loadout/ui": "workspace:*",
    "@loadout/types": "workspace:*",
    "@loadout/exec": "workspace:*",
    "@loadout/plugin-storage": "workspace:*",
    "@loadout/devices": "workspace:*",
    "@loadout/wake": "workspace:*"
  },
  "plugin": {
    "id": "apex",
    "name": "OneXPlayer",
    "description": "OneXPlayer device fixes: recover the internal gamepad when its xHCI controller dies on resume — manually or automatically on every wake — and block the fingerprint reader from waking the device on a light touch.",
    "permissions": {
      "commands": [
        "tee",
        "lsusb",
        "dmesg",
        "dbus-monitor",
        "systemctl",
        "sh",
        "udevadm",
        "steamos-readonly",
        "update-grub"
      ]
    },
    "category": "Device",
    "subtitle": "Gamepad + fingerprint fixes",
    "target": {
      "type": "overlay"
    }
  }
}
