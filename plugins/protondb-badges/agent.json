            "type": "boolean"
          },
          "settings": {
            "type": "object",
            "properties": {
              "size": {
                "type": "string",
                "enum": [
                  "regular",
                  "small",
                  "minimalist"
                ]
              },
              "position": {
                "type": "string",
                "enum": [
                  "tl",
                  "tm",
                  "tr",
                  "bl",
                  "bm",
                  "br"
