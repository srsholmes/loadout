{
  "name": "@loadout/plugin-library-tabs",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "dependencies": {
    "@loadout/types": "workspace:*",
    "@loadout/plugin-storage": "workspace:*",
    "@loadout/steam-paths": "workspace:*",
    "@loadout/steam-cdp": "workspace:*",
    "@loadout/vdf": "workspace:*",
    "react": "^18.3.0",
    "react-icons": "^5.6.0",
    "@loadout/ui": "workspace:*"
  },
  "plugin": {
    "id": "library-tabs",
    "name": "Library Tabs",
    "description": "Custom, filter-driven tabs for your game library — shown in Steam's own library as real tabs, with live match counts, nested rules, and optional mirroring into Steam collections",
    "category": "Steam",
    "subtitle": "Organise your library",
    "target": {
      "type": "overlay"
    },
    "permissions": {
      "filesystem": [
        "read:~/.local/share/Steam",
        "write:~/.config/loadout/plugins"
      ],
      "network": [
        "localhost",
        "127.0.0.1"
      ]
    },
    "patches": [
      {
        "find": "return[p.filter(e=>e),k!=F]",
        "replacement": {
          "match": "return[p.filter(e=>e),k!=F]",
          "replace": "return[(globalThis.__LOADOUT_LT?globalThis.__LOADOUT_LT.extend(p,i,Gc,d):p).filter(e=>e),k!=F]"
        }
      }
    ]
  }
}
