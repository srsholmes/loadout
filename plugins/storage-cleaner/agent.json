          "deleted",
          "errors"
        ]
      },
      "description": "Delete compatdata (Proton prefix) for specific app IDs.",
      "safety": "write",
      "safetyInferred": true
    },
    {
      "name": "cleanShaderCache",
      "args": [
        {
          "name": "appIds",
          "schema": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "optional": false
        }
      ],
      "returns": {
        "type": "object",
        "properties": {
          "deleted": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "deleted",
          "errors"
        ]
      },
      "description": "Delete shader cache for specific app IDs. Uses `fs.rm` directly instead of forking `rm -rf` — the appId validation guarantees the leaf segment is a safe digit-only token, and `fs.rm` removes the subprocess boundary as a vector for argv escaping mistakes.",
      "safety": "write",
      "safetyInferred": true
    },
