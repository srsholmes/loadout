    {
      "name": "getDailyBreakdown",
      "args": [],
      "returns": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "day": {
              "type": "string",
              "description": "Short day label, e.g. \"Mon\"."
            },
            "dayStart": {
              "type": "number",
              "description": "Epoch ms at local start-of-day — stable React key + filter id."
            },
            "totalMs": {
              "type": "number",
              "description": "Sum of all game time on this day."
            },
            "games": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "appId": {
                    "type": "string"
                  },
                  "gameName": {
                    "type": "string"
                  },
                  "totalMs": {
                    "type": "number"
                  }
                },
                "required": [
                  "appId",
                  "gameName",
                  "totalMs"
                ]
              },
              "description": "Per-game totals for this day, sorted by totalMs descending."
            }
          },
          "required": [
            "day",
            "dayStart",
            "totalMs",
            "games"
          ]
        }
      },
      "description": "Return the rolling 7-day breakdown with per-game totals per day. Drives the day-filter bars and the day-filtered \"All games\" grid in the UI (which `getStats().weeklyBreakdown` can't, as it only carries per-day totals — no per-game split).",
      "safety": "read",
      "safetyInferred": true
    },
