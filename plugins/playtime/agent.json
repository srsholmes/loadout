            },
            "totalMs": {
              "type": "number"
            }
          },
          "required": [
            "appId",
            "gameName",
            "totalMs"
          ]
        }
      },
      "description": "Return Steam's own lifetime playtime per game, parsed from each user's `localconfig.vdf`. No login/API key needed — Steam keeps this locally. Powers the all-time \"All Games\" grid so it reflects real library history, not just sessions since this plugin was installed. Returns minutes-as-ms totals, sorted most-played first.",
      "safety": "read",
      "safetyInferred": true
